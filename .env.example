# CodeInsight 环境变量样例
#
# 复制成 `.env` 后填真值。`.env` 已被 gitignore，**不会进仓库**。
# 密钥只从环境变量读——不落库、不进日志、不进索引库。

# ── 存储 ──────────────────────────────────────────────
CI_DATA_DIR=./.ci

# ── LLM（M3 用；M1/M2 不需要）──────────────────────────
CI_LLM_PROVIDER=deepseek
CI_LLM_BASE_URL=https://api.deepseek.com/v1
CI_LLM_MODEL=deepseek-chat
CI_LLM_API_KEY=

# ── 嵌入（稠密检索通道用）─────────────────────────────
# 硅基流动（BAAI/bge-m3，1024 维，OpenAI 兼容接口）
CI_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
CI_EMBEDDING_MODEL=BAAI/bge-m3
CI_EMBEDDING_DIM=1024
CI_EMBEDDING_API_KEY=

# ── 切块 ──────────────────────────────────────────────
CI_MAX_CHUNK_LINES=120

# ── 检索 ──────────────────────────────────────────────
CI_RETRIEVAL_TOP_K=8
CI_RETRIEVAL_RRF_K=60
CI_RETRIEVAL_NEIGHBOR_DEPTH=1

# ── 分析生命周期 ──────────────────────────────────────
# 0 = 不限制一次问题的总模型轮次；正数仅在主动需要限额时使用。
CI_MAX_MODEL_TURNS=0
