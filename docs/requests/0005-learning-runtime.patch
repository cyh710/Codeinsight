--- a/src/codeinsight/api/learning.py
+++ b/src/codeinsight/api/learning.py
@@ -0,0 +1,32 @@
+"""内置知识 API：全局教材不依赖项目库或模型服务。"""
+from typing import Any
+from fastapi import APIRouter, Query
+from codeinsight.api.errors import ApiFailure
+from codeinsight.cognitive.concepts.assets import knowledge_directory
+from codeinsight.cognitive.concepts.integration import LearningBridge
+from codeinsight.cognitive.concepts.learning_models import KnowledgeError
+from codeinsight.cognitive.concepts.library import LearningLibrary
+from codeinsight.cognitive.concepts.service import KnowledgeService
+
+router = APIRouter(tags=["learning"])
+
+def _bridge() -> LearningBridge:
+    try:
+        return LearningBridge(KnowledgeService(LearningLibrary(knowledge_directory("learning"))))
+    except KnowledgeError as exc:
+        raise ApiFailure(status_code=503, code="internal_error", title="知识库暂不可用", hint="请检查知识资产安装。", detail=str(exc)) from exc
+
+@router.get("/knowledge/tree")
+def knowledge_tree() -> dict[str, Any]:
+    return _bridge().tree().data
+
+@router.get("/knowledge/topics/{topic_id}")
+def knowledge_topic(topic_id: str) -> dict[str, Any]:
+    result = _bridge().topic(topic_id)
+    if result.error:
+        raise ApiFailure(status_code=404, code="not_found", title="知识主题不存在", hint="请从知识目录重新选择。")
+    return result.data
+
+@router.get("/knowledge/search")
+def knowledge_search(q: str = "", limit: int = Query(default=5, ge=1, le=50)) -> dict[str, Any]:
+    return _bridge().search(q, limit).data
